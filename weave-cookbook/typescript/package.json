{
  "name": "weave-cookbook-ts",
  "version": "0.1.0",
  "description": "Runnable W&B Weave cookbook examples in TypeScript",
  "author": "Lorenzo Balderrama",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "hello": "tsx examples/00-hello-trace.ts",
    "recommend": "tsx examples/01-trace-recommendation.ts",
    "evaluate": "tsx examples/02-evaluate.ts",
    "eval-logger": "tsx examples/02-eval-logger.ts",
    "judge": "tsx examples/03-llm-judge.ts",
    "versioning": "tsx examples/04-versioning.ts",
    "prompts": "tsx examples/05-prompts.ts",
    "inference": "tsx examples/06-inference.ts",
    "otel": "tsx examples/08-otel.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.53.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "openai": "^7.3.0",
    "weave": "^0.16.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
